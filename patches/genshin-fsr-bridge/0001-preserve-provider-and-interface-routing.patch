diff --git a/Dx11FsrBridge/ComMethodRoutes.h b/Dx11FsrBridge/ComMethodRoutes.h
new file mode 100644
index 0000000000000000000000000000000000000000..4ea50102c245d6723c48f5663901ebf68b5db9ef
--- /dev/null
+++ b/Dx11FsrBridge/ComMethodRoutes.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include "CreateFunctionRoutes.h"
+#include <d3d11.h>
+#include <type_traits>
+
+inline thread_local unsigned context_policy_bypass = 0;
+
+class ContextPolicyBypass
+{
+public:
+    explicit ContextPolicyBypass(ID3D11DeviceContext *) { ++context_policy_bypass; }
+    ~ContextPolicyBypass() { --context_policy_bypass; }
+    ContextPolicyBypass(const ContextPolicyBypass &) = delete;
+    ContextPolicyBypass &operator=(const ContextPolicyBypass &) = delete;
+};
+
+// 2026-11-14：生产 DLL 的成功设备回归证实，全局 original 会把 proxy this 传入
+// native 实现。正常回调只取匹配的 TLS 帧；内部跨对象调用才解析对象当前的方法槽。
+template <typename Function, Function Observe, std::size_t Method, bool SkipNested = false>
+class ComMethodRoutes;
+
+template <typename Result, typename Object, typename... Args,
+    Result(STDMETHODCALLTYPE *Observe)(Object *, Args...), std::size_t Method, bool SkipNested>
+class ComMethodRoutes<Result(STDMETHODCALLTYPE *)(Object *, Args...), Observe, Method, SkipNested>
+{
+    using Function = Result(STDMETHODCALLTYPE *)(Object *, Args...);
+    struct Frame
+    {
+        Frame *previous;
+        Function original;
+        Object *object;
+    };
+    inline static thread_local Frame *active_ = nullptr;
+    inline static std::atomic<bool> installed_ {};
+
+    static Result STDMETHODCALLTYPE invoke(Object *object, Args... args)
+    {
+        Frame frame { active_, Routes::original(), object };
+        active_ = &frame;
+        struct Restore
+        {
+            Frame *previous;
+            ~Restore() { active_ = previous; }
+        } restore { frame.previous };
+        if constexpr (std::is_same_v<Object, ID3D11DeviceContext>)
+            if (context_policy_bypass != 0)
+                return frame.original(object, args...);
+        // Draw/Dispatch/Present 的业务接管只发生一次；资源与 shader 返回观察独立保留。
+        if constexpr (SkipNested)
+            if (frame.previous != nullptr)
+                return frame.original(object, args...);
+        return Observe(object, args...);
+    }
+
+    using Routes = CreateFunctionRoutes<Function, &invoke>;
+
+public:
+    static void *bind(void *target)
+    {
+        const auto entry = Routes::bind(reinterpret_cast<Function>(target));
+        if (entry != nullptr)
+            installed_.store(true, std::memory_order_release);
+        return reinterpret_cast<void *>(entry);
+    }
+
+    static Function original_for(Object *object)
+    {
+        for (auto *frame = active_; frame != nullptr; frame = frame->previous)
+            if (frame->object == object)
+                return frame->original;
+        if (object == nullptr)
+            return nullptr;
+        auto **table = *reinterpret_cast<void ***>(object);
+        return Routes::target(reinterpret_cast<Function>(table[Method]));
+    }
+
+    Result operator()(Object *object, Args... args) const
+    {
+        const Function original = original_for(object);
+        if (original != nullptr)
+            return original(object, args...);
+        if constexpr (!std::is_void_v<Result>)
+            return static_cast<Result>(E_UNEXPECTED);
+    }
+
+    bool operator==(std::nullptr_t) const { return !installed_.load(std::memory_order_acquire); }
+    bool operator!=(std::nullptr_t) const { return installed_.load(std::memory_order_acquire); }
+};
diff --git a/Dx11FsrBridge/CreateFunctionRoutes.h b/Dx11FsrBridge/CreateFunctionRoutes.h
new file mode 100644
index 0000000000000000000000000000000000000000..1dc5f55fc81066f5c43d312dcacaaf44b035f457
--- /dev/null
+++ b/Dx11FsrBridge/CreateFunctionRoutes.h
@@ -0,0 +1,95 @@
+#pragma once
+
+#include <Windows.h>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <mutex>
+#include <utility>
+
+// 2026-11-14：Rocket 与系统 D3D11 可以同名共存；实测单个 original 会把第二个
+// provider 的调用转给第一个。按真实 callable 绑定入口，嵌套时只恢复当前线程上下文。
+template <typename Function, Function Observe, std::size_t Capacity = 16>
+class CreateFunctionRoutes;
+
+template <typename Result, typename... Args, Result(WINAPI *Observe)(Args...), std::size_t Capacity>
+class CreateFunctionRoutes<Result(WINAPI *)(Args...), Observe, Capacity>
+{
+    using Function = Result(WINAPI *)(Args...);
+    inline static std::array<std::atomic<Function>, Capacity> originals_ {};
+    inline static std::mutex install_mutex_;
+    inline static thread_local Function current_ = nullptr;
+
+    struct CallScope
+    {
+        Function previous = current_;
+
+        explicit CallScope(Function original)
+        {
+            current_ = original;
+        }
+
+        ~CallScope()
+        {
+            current_ = previous;
+        }
+    };
+
+    template <std::size_t Index>
+    static Result WINAPI invoke(Args... args)
+    {
+        CallScope scope(originals_[Index].load(std::memory_order_acquire));
+        return Observe(args...);
+    }
+
+    template <std::size_t... Indices>
+    static constexpr auto make_entries(std::index_sequence<Indices...>)
+    {
+        return std::array<Function, Capacity> { &invoke<Indices>... };
+    }
+
+    inline static constexpr auto entries_ = make_entries(std::make_index_sequence<Capacity> {});
+
+public:
+    static Function original()
+    {
+        return current_;
+    }
+
+    static Function target(Function entry)
+    {
+        for (std::size_t i = 0; i < Capacity; ++i)
+            if (entry == entries_[i])
+                return originals_[i].load(std::memory_order_acquire);
+        return entry;
+    }
+
+    static Function bind(Function target, bool *added = nullptr)
+    {
+        if (added != nullptr)
+            *added = false;
+        if (target == nullptr)
+            return nullptr;
+        // IAT 重扫可能看到已安装入口；不能再把自己的入口当作新的 original。
+        for (Function entry : entries_)
+            if (target == entry)
+                return entry;
+
+        std::lock_guard lock(install_mutex_);
+        for (std::size_t i = 0; i < Capacity; ++i)
+            if (originals_[i].load(std::memory_order_relaxed) == target)
+                return entries_[i];
+        for (std::size_t i = 0; i < Capacity; ++i)
+        {
+            if (originals_[i].load(std::memory_order_relaxed) == nullptr)
+            {
+                originals_[i].store(target, std::memory_order_release);
+                if (added != nullptr)
+                    *added = true;
+                return entries_[i];
+            }
+        }
+        // 无可用静态入口时保留原调用，不能退回其它 provider 的 original。
+        return nullptr;
+    }
+};
