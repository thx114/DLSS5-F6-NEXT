# Local build outputs and retained runtime evidence; Git ignores them.
# build/ also holds candidate DLLs, rollback bytes and receipts: preserve these.
/build/

# Generated by the Release/ReleaseDebug PreBuildEvent.
/OptiScaler/resource_build_date.h
/OptiScaler/resource_build_commit.h

# MSVC / MSBuild intermediates
*.obj
*.iobj
*.pch
*.ipch
*.pdb
*.ipdb
*.ilk
*.exp
*.tlog
*.lastbuildstate
*.recipe
obj/
bin/
x64/

# Python tool caches
__pycache__/
*.py[cod]

# IDE / local user state
.vs/
.vscode/
*.user
*.suo

# Preserve vendored dependencies, including their intentional binaries/bin dirs.
!/external/**
